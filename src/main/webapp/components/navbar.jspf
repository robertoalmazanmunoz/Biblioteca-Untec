<%@ taglib prefix="c" uri="jakarta.tags.core" %>

<nav class="navbar navbar-expand-lg navbar-dark bg-dark shadow-sm">
    <div class="container">
        <a class="navbar-brand fw-bold" href="${pageContext.request.contextPath}/index.jsp">
            Biblioteca Untec
        </a>
        <button
            class="navbar-toggler"
            type="button"
            data-bs-toggle="collapse"
            data-bs-target="#navbarPrincipal"
            aria-controls="navbarPrincipal"
            aria-expanded="false"
            aria-label="Mostrar navegación">
            <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse" id="navbarPrincipal">
            <ul class="navbar-nav ms-auto">
                <li class="nav-item">
                    <a class="nav-link" href="${pageContext.request.contextPath}/index.jsp">
                        Home
                    </a>
                </li>
                <!-- USUARIO AUTENTICADO -->
                <c:if test="${not empty sessionScope.usuario}">
                	<li class="nav-item">
	                    <a class="nav-link" href="${pageContext.request.contextPath}/menu.jsp">
	                        Menú
	                    </a>
	                </li>
                	<!-- ADMIN -->
                    <c:if test="${sessionScope.rol == 'Administrador'}">
                        <li class="nav-item">
                            <a class="nav-link" href="${pageContext.request.contextPath}/agregar.jsp">
                                Agregar Libro
                            </a>
                        </li>
                    </c:if>
                    <!-- LISTADO -->
                    <li class="nav-item">
                        <a class="nav-link" href="${pageContext.request.contextPath}/BuscarLibro">
                            Catálogo de Libros
                        </a>
                    </li>
					<!-- USUARIO -->
                    <li class="nav-item">
                        <span class="btn btn-primary">
                            ${sessionScope.usuario.usuario}                            -
                            ${sessionScope.rol}
                        </span>
                    </li>

                    <!-- LOGOUT -->
                    <li class="nav-item">
                        <a class="nav-link" href="${pageContext.request.contextPath}/Logout">
                            Cerrar sesión
                        </a>
                    </li>
                </c:if>

                <!-- VISITANTE NO AUTENTICADO -->
                <c:if test="${empty sessionScope.usuario}">
                    <li class="nav-item">
                        <a class="nav-link" href="${pageContext.request.contextPath}/Login">
                            Login
                        </a>
                    </li>
                </c:if>
            </ul>
        </div>
    </div>
</nav>